# ============================================================
# MYSHOP — Environment Variables Example
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ─── Supabase ───────────────────────────────────────────────
# Your project URL — safe to expose (public)
SUPABASE_URL=https://uxkjpbyidmuedboisdph.supabase.co

# Anon (public) key — safe to expose with correct RLS rules
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_ANON_KEY=your-anon-key-here

# Publishable key (modern alternative to anon key)
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# DB password — used only by Supabase CLI for migrations
# NEVER put in Android app or browser JS
SUPABASE_DB_PASSWORD=your-secure-database-password

# Service role key — NEVER in Android, NEVER in browser JS
# Used ONLY in edge functions and server-side automation
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  <-- keep commented unless needed

# Project ref (for `supabase link`)
SUPABASE_PROJECT_REF=uxkjpbyidmuedboisdph

# ─── GitHub Actions Secrets ─────────────────────────────────
# Set these in GitHub → Settings → Secrets → Actions

# Vercel deploy token
# VERCEL_TOKEN=your-vercel-token

# Android release signing (base64-encoded .jks keystore)
# RELEASE_KEYSTORE_BASE64=$(base64 -w 0 myshop-release.jks)
# KEYSTORE_PASSWORD=your-keystore-password
# KEY_ALIAS=myshop-key
# KEY_PASSWORD=your-key-password

# ─── Admin Panel (Vercel) ────────────────────────────────────
# Set as Vercel project environment variables:
# SUPABASE_URL   → @myshop-supabase-url
# SUPABASE_ANON_KEY → @myshop-supabase-anon-key

# ─── FCM Push Notifications ─────────────────────────────────
# Set in Supabase Edge Function secrets:
# FCM_SERVER_KEY=your-firebase-server-key
# (supabase secrets set FCM_SERVER_KEY=...)

# ─── Android local.properties ───────────────────────────────
# Created automatically by CI; for local development:
# android/local.properties:
#   sdk.dir=/path/to/your/android/sdk
#   supabase.url=https://your-project-ref.supabase.co
#   supabase.anonKey=eyJ...
